class ObjectOriented {
    void abstraction() { System.out.println("Abstraction concept"); }
    void polymorphism() { System.out.println("Polymorphism concept"); }
    void inheritance() { System.out.println("Inheritance concept"); }
}

class JavaLanguage extends ObjectOriented {
    void persistence() { System.out.println("Java Persistence"); }
    void interfaces() { System.out.println("Java Interfaces"); }
}

class Cpp extends ObjectOriented {
    void template() { System.out.println("C++ Templates"); }
    void friendFunction() { System.out.println("C++ Friend Function"); }
}

public class Main {
    public static void main(String[] args) {
        JavaLanguage j = new JavaLanguage();
        j.abstraction(); j.polymorphism(); j.inheritance();
        j.persistence(); j.interfaces();

        Cpp c = new Cpp();
        c.abstraction(); c.polymorphism(); c.inheritance();
        c.template(); c.friendFunction();
    }
}
